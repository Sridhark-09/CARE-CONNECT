<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/pickerMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/pickerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E6FFFFFF"
        android:padding="10dp"
        android:text="Zoom in and tap the exact spot to place the pin."
        android:textColor="#0F2A44"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pickerAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="64dp"
        android:background="#CCFFFFFF"
        android:padding="4dp"
        android:textColor="#333333"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E6FFFFFF"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/pickerGpsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="USE MY GPS"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <Button
            android:id="@+id/pickerStyleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="STYLE"
            android:textColor="@color/white"
            android:textSize="11sp" />

        <Button
            android:id="@+id/pickerConfirmButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/success"
            android:text="CONFIRM"
            android:textColor="@color/white"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>