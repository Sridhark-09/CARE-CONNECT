<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reminders"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/typeSpinner"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/reminderPatientInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Patient name"
        android:padding="12dp" />

    <EditText
        android:id="@+id/reminderDateInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Due date (dd-MM-yyyy)"
        android:padding="12dp" />

    <EditText
        android:id="@+id/reminderNoteInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Note (medicine name, vaccine, etc.)"
        android:padding="12dp" />

    <Button
        android:id="@+id/addReminderButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="ADD REMINDER"
        android:textColor="@color/white"
        android:backgroundTint="@color/primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tap to mark done. Long-press to delete."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/reminderListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp" />

</LinearLayout>